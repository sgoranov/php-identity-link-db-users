<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <title>{{ 'reset_password_email.subject'|trans({}, 'messages') }}</title>
</head>
<body style="margin:0; padding:0; background-color:#f6f8fa; font-family:Arial, Helvetica, sans-serif; color:#212529;">

<table width="100%" cellpadding="0" cellspacing="0" style="padding:30px 0;">
    <tr>
        <td align="center">

            <table width="600" cellpadding="0" cellspacing="0"
                   style="background:#ffffff; border-radius:8px; padding:30px; border:1px solid #e9ecef;">
                <tr>
                    <td>

                        <p style="font-size:16px; line-height:1.5; margin:0 0 16px;">
                            {{ 'reset_password_email.greeting'|trans }}
                        </p>

                        <p style="font-size:16px; line-height:1.5; margin:0 0 24px;">
                            {{ 'reset_password_email.body'|trans }}
                        </p>

                        <p style="text-align:center; margin:30px 0;">
                            <a href="{{ resetUrl }}"
                               style="
                                       display:inline-block;
                                       padding:12px 24px;
                                       background-color:#0d6efd;
                                       color:#ffffff;
                                       text-decoration:none;
                                       border-radius:6px;
                                       font-size:16px;
                                       font-weight:bold;
                                   ">
                                {{ 'reset_password_email.button'|trans }}
                            </a>
                        </p>

                        <p style="font-size:16px; line-height:1.5; margin:0 0 16px;">
                            {{ 'reset_password_email.ignore'|trans }}
                        </p>

                        <p style="font-size:14px; line-height:1.5; color:#6c757d; margin:0;">
                            {{ 'reset_password_email.regards'|trans|raw }}
                        </p>

                    </td>
                </tr>
            </table>

        </td>
    </tr>
</table>

</body>
</html>