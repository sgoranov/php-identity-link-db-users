{% extends 'base.html.twig' %}

{% block content %}
    <div class="container mx-auto max-w-md p-4 bg-white rounded-lg shadow-md text-center">

        <h1 class="text-xl sm:text-2xl font-bold mb-4 break-words">
            {{ 'reset_password_request.title'|trans }}
        </h1>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 px-4 py-3 rounded-md text-sm sm:text-base font-medium alert alert-info">
                    {{ message|raw }}
                </div>
            {% endfor %}
        {% endfor %}

        <p class="mb-4 text-sm sm:text-base break-words">
            {{ 'reset_password_request.instructions'|trans }}
        </p>

        <div class="mb-6">
            {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
            {{ form_row(form.email, {
                'attr': {
                    'class': 'w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500'
                }
            }) }}
            {{ form_end(form) }}
        </div>

        {% if redirectUrl %}
            <div class="text-sm sm:text-base">
                <a href="{{ redirectUrl }}"
                   class="text-blue-600 hover:underline">
                    {{ 'reset_password_request.back_to_login'|trans }}
                </a>
            </div>
        {% endif %}
    </div>
{% endblock %}
